<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <RootNamespace>Siraj.App</RootNamespace>
    <AssemblyName>Siraj</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Siraj.ico</ApplicationIcon>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <EnableMsixTooling>true</EnableMsixTooling>
    <SelfContained>true</SelfContained>
    <!-- Program.cs owns Main for single-instance redirection. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <SatelliteResourceLanguages>en;ar;tr;ur</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>SirajUpdateSource</_Parameter1>
      <_Parameter2>$(UpdateSource)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <DebugType>none</DebugType>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup Condition="'$(Configuration)' == 'Release'">
    <!-- CsWinRT resolves WinRT projection vtables via reflection; trimming these breaks SystemBackdrop in Release. -->
    <TrimmerRootAssembly Include="Microsoft.WinUI" />
    <TrimmerRootAssembly Include="Microsoft.InteractiveExperiences.Projection" />
    <TrimmerRootAssembly Include="WinRT.Runtime" />
  </ItemGroup>

  <ItemGroup>
    <!-- Individual Windows App SDK packages rather than the metapackage to avoid pulling in unused ML runtimes. -->
    <PackageReference Include="Microsoft.WindowsAppSDK.Base" Version="2.6.4" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Foundation" Version="2.6.4" />
    <PackageReference Include="Microsoft.WindowsAppSDK.InteractiveExperiences" Version="2.6.4" />
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.6.4" />
    <PackageReference Include="Microsoft.WindowsAppSDK.DWrite" Version="2.6.4" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Runtime" Version="2.6.4" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2957" />
    <PackageReference Include="Microsoft.Graphics.Win2D" Version="1.4.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Siraj.Core\Siraj.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\**\*" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="Strings\*.json" LogicalName="Siraj.App.Strings.%(Filename).json" />
  </ItemGroup>
</Project>
