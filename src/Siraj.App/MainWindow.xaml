<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Siraj.App.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Siraj.App.Controls">
    <Grid x:Name="Root" Background="{ThemeResource SirajBackgroundBrush}">
        <controls:LiveBackdropControl x:Name="Backdrop" />

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid x:Name="TitleBar" Grid.Row="0" Padding="18,0,144,0" Background="Transparent" FlowDirection="LeftToRight">
                <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                    <Image Source="ms-appx:///Assets/Siraj.png" Width="17" Height="17" />
                    <TextBlock x:Name="TitleText" Text="Siraj" FontFamily="{StaticResource SirajFont}" FontSize="12.5"
                               FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{ThemeResource SirajOnSurfaceVariantBrush}" />
                </StackPanel>
            </Grid>

            <Grid x:Name="Shell" Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="RailColumn" Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border x:Name="NavDock" Grid.Column="0" Margin="14,4,8,16" Padding="10,14,10,12"
                        CornerRadius="26" Width="216"
                        Background="{ThemeResource SirajGlassElevatedBrush}"
                        BorderBrush="{ThemeResource SirajGlassBorderBrush}"
                        BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid x:Name="BrandHeader" Padding="8,4,8,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="BrandBadge" Width="38" Height="38" CornerRadius="13"
                                    Background="{ThemeResource SirajPrimaryBrush}" />
                            <StackPanel x:Name="BrandLabels" Grid.Column="1" VerticalAlignment="Center" Margin="11,0,0,0" Spacing="0">
                                <TextBlock x:Name="BrandTitle" Text="Siraj" FontFamily="{StaticResource SirajFont}"
                                           FontSize="16" FontWeight="Bold" Foreground="{ThemeResource SirajPrimaryBrush}" />
                                <TextBlock x:Name="BrandSub" FontFamily="{StaticResource SirajFont}"
                                           FontSize="11" Foreground="{ThemeResource SirajOnSurfaceVariantBrush}"
                                           TextTrimming="CharacterEllipsis" MaxLines="1" />
                            </StackPanel>
                        </Grid>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <Grid x:Name="NavItemsHost">
                                <Border x:Name="ActivePill" Height="44" CornerRadius="16"
                                        VerticalAlignment="Top" HorizontalAlignment="Stretch"
                                        Background="{ThemeResource SirajPrimarySoftBrush}"
                                        BorderBrush="{ThemeResource SirajPrimaryBorderBrush}"
                                        BorderThickness="1" IsHitTestVisible="False" />
                                <StackPanel x:Name="NavList" Spacing="4" />
                            </Grid>
                        </ScrollViewer>

                        <StackPanel Grid.Row="2" Spacing="4" Margin="0,10,0,0">
                            <Border Height="1" Background="{ThemeResource SirajDividerBrush}" Margin="8,0,8,8" />
                            <StackPanel x:Name="FooterNavList" Spacing="4" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border x:Name="UpdateBanner" Grid.Row="0" Visibility="Collapsed"
                            Margin="24,4,24,6" Padding="14,10" CornerRadius="18"
                            Background="{ThemeResource SirajGlassElevatedBrush}"
                            BorderBrush="{ThemeResource SirajPrimaryBorderBrush}"
                            BorderThickness="1" />
                    <Frame x:Name="ContentFrame" Grid.Row="1" Background="Transparent" />
                    <controls:NowPlayingBar x:Name="MiniPlayer" Grid.Row="1" VerticalAlignment="Bottom" />
                </Grid>
            </Grid>

            <Frame x:Name="SetupFrame" Grid.Row="1" Visibility="Collapsed" Background="Transparent" />
        </Grid>

        <controls:FullPlayerOverlay x:Name="FullPlayer" />
    </Grid>
</Window>
