<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Siraj.App.Views.QuranPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">
    <Grid MaxWidth="1120" Padding="28,12,28,0">
        <Border x:Name="DownloadCard" Style="{StaticResource SirajCard}" VerticalAlignment="Top" MaxWidth="720" HorizontalAlignment="Left" Padding="28" Visibility="Collapsed">
            <StackPanel Spacing="14">
                <TextBlock x:Name="DownloadTitle" Style="{StaticResource SirajHeading}" FontSize="22" />
                <TextBlock x:Name="DownloadBody" Style="{StaticResource SirajBody}" Foreground="{ThemeResource SirajOnSurfaceVariantBrush}" />
                <ProgressBar x:Name="DownloadBar" Maximum="1" Visibility="Collapsed" />
                <TextBlock x:Name="DownloadStatus" Style="{StaticResource SirajCaption}" />
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button x:Name="DownloadButton" Style="{StaticResource SirajPrimaryButton}" Click="OnDownload" />
                    <Button x:Name="CancelButton" Style="{StaticResource SirajButton}" Click="OnCancel" Visibility="Collapsed" />
                </StackPanel>
            </StackPanel>
        </Border>

        <ListView x:Name="List" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnItemClick"
                  Padding="0,0,0,96" Visibility="Collapsed" ShowsScrollingPlaceholders="False">
            <ListView.Header>
                <StackPanel x:Name="HeaderPanel" Spacing="14" Margin="0,0,0,12">
                    <Grid ColumnSpacing="12" Margin="4,0,4,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="TitleText" Style="{StaticResource SirajTitle}" VerticalAlignment="Center" />
                        <Button x:Name="ListenShortcut" Grid.Column="1" Style="{StaticResource SirajButton}" Click="OnOpenListen" VerticalAlignment="Center" />
                    </Grid>

                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <AutoSuggestBox x:Name="SearchBox" TextChanged="OnSearchChanged" QuerySubmitted="OnSearchSubmitted"
                                        CornerRadius="22" VerticalAlignment="Center">
                            <AutoSuggestBox.TextBoxStyle>
                                <Style TargetType="TextBox" BasedOn="{StaticResource AutoSuggestBoxTextBoxStyle}">
                                    <Setter Property="IsSpellCheckEnabled" Value="False" />
                                    <Setter Property="CornerRadius" Value="22" />
                                    <Setter Property="Padding" Value="16,10,12,10" />
                                </Style>
                            </AutoSuggestBox.TextBoxStyle>
                        </AutoSuggestBox>
                        <Button x:Name="QuickJuzBtn" Grid.Column="1" Width="44" Height="44" Padding="0" CornerRadius="22"
                                Style="{StaticResource SirajButton}" Click="OnQuickToggleJuz" />
                    </Grid>

                    <ContentControl x:Name="ContinueSlot" HorizontalContentAlignment="Stretch" />
                    <ContentControl x:Name="KhatmaSlot" HorizontalContentAlignment="Stretch" />

                    <ContentControl x:Name="TabsSlot" HorizontalContentAlignment="Left" />
                </StackPanel>
            </ListView.Header>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0,0,0,8" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListView.ItemContainerStyle>
        </ListView>
    </Grid>
</Page>
