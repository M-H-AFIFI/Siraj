<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Siraj.App.Views.WidgetsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="1180" Padding="32,12,32,96" Spacing="4">
            <TextBlock x:Name="TitleText" Style="{StaticResource SirajTitle}" Margin="4,0,0,0" />
            <TextBlock x:Name="DescText" Style="{StaticResource SirajCaption}" FontSize="14" Margin="4,0,4,0" MaxWidth="760" HorizontalAlignment="Left" />
            <StackPanel x:Name="TaskbarSection" Spacing="8" Margin="0,8,0,8" />
            <TextBlock x:Name="PlacedTitle" Style="{StaticResource SirajSectionHeader}" />
            <StackPanel x:Name="Placed" Spacing="8" />
            <TextBlock x:Name="GalleryTitle" Style="{StaticResource SirajSectionHeader}" />
            <VariableSizedWrapGrid x:Name="Gallery" Orientation="Horizontal" ItemWidth="388" ItemHeight="470" />
        </StackPanel>
    </ScrollViewer>
</Page>
