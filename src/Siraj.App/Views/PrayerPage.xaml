<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Siraj.App.Views.PrayerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Siraj.App.Controls"
    Background="Transparent">
    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="1180" Padding="28,8,28,96" Spacing="20">

            <Grid Margin="4,0,4,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="1" VerticalAlignment="Center">
                    <TextBlock x:Name="AppTitleText" FontFamily="{StaticResource SirajFont}" FontSize="26" FontWeight="Bold"
                               Foreground="{ThemeResource SirajPrimaryBrush}" />
                    <TextBlock x:Name="GreetingText" Style="{StaticResource SirajCaption}" FontWeight="SemiBold" />
                </StackPanel>
                <Button x:Name="PlaceButton" Grid.Column="1" VerticalAlignment="Center" Click="OnPlace"
                        CornerRadius="22" Padding="15,9,13,9"
                        Background="{ThemeResource SirajGlassPillBrush}"
                        BorderBrush="{ThemeResource SirajGlassBorderBrush}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                        <controls:SirajVectorIcon IconKey="location_on" Width="16" Height="16"
                                                  Brush="{ThemeResource SirajPrimaryBrush}" VerticalAlignment="Center" />
                        <TextBlock x:Name="PlaceText" FontFamily="{StaticResource SirajFont}" FontSize="14" FontWeight="Bold"
                                   Foreground="{ThemeResource SirajOnSurfaceBrush}" VerticalAlignment="Center" />
                        <controls:SirajVectorIcon IconKey="expand_more" Width="15" Height="15"
                                                  Brush="{ThemeResource SirajOnSurfaceVariantBrush}" VerticalAlignment="Center" Margin="1,1,0,0" />
                    </StackPanel>
                </Button>
            </Grid>

            <controls:SkyCard />

            <StackPanel x:Name="QuickActions" Spacing="14">
                <Button x:Name="OpenQuranBtn" HorizontalAlignment="Stretch" Height="60" CornerRadius="22"
                        Background="{ThemeResource SirajPrimaryBrush}" Foreground="{ThemeResource SirajOnPrimaryBrush}"
                        BorderThickness="0" Click="OnOpenQuran">
                    <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <ContentControl x:Name="OpenQuranIcon" VerticalAlignment="Center" />
                        <TextBlock x:Name="OpenQuranText" FontFamily="{StaticResource SirajFont}" FontSize="18" FontWeight="Bold"
                                   Foreground="{ThemeResource SirajOnPrimaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Grid x:Name="QuickTilesGrid" ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                </Grid>
            </StackPanel>

            <Grid x:Name="Lower" ColumnSpacing="20" RowSpacing="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="LeftColumn" Width="3*" />
                    <ColumnDefinition x:Name="RightColumn" Width="2*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel x:Name="PrimaryColumn" Spacing="20">
                    <Border x:Name="TimesCard" Style="{StaticResource SirajCard}" Padding="16,18">
                        <StackPanel>
                            <Grid Padding="6,0,6,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="TimesTitle" Style="{StaticResource SirajHeading}" FontSize="18" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" HorizontalAlignment="Right" Spacing="1">
                                    <TextBlock x:Name="DateText" Style="{StaticResource SirajCaption}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                    <TextBlock x:Name="MethodText" Style="{StaticResource SirajCaption}" FontSize="11.5" HorizontalAlignment="Right"
                                               TextTrimming="CharacterEllipsis" MaxWidth="260" Opacity="0.8" />
                                </StackPanel>
                            </Grid>
                            <StackPanel x:Name="Rows" Spacing="5" />
                        </StackPanel>
                    </Border>

                    <StackPanel x:Name="DynamicPrimarySlot" Spacing="20" />
                </StackPanel>

                <StackPanel x:Name="Side" Grid.Column="1" Spacing="20">
                    <StackPanel x:Name="DailyCardsSlot" Spacing="20" />

                    <Border x:Name="MoonCard" Style="{StaticResource SirajCard}" Padding="18,16" Tapped="OnCalendar">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="MoonHost" Width="56" Height="56" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                <TextBlock x:Name="MoonTitle" Style="{StaticResource SirajHeading}" FontSize="15" />
                                <TextBlock x:Name="MoonPhaseText" Style="{StaticResource SirajBody}" FontSize="13.5" FontWeight="SemiBold"
                                           Foreground="{ThemeResource SirajPrimaryBrush}" />
                                <TextBlock x:Name="MoonText" Style="{StaticResource SirajCaption}" FontSize="12" TextWrapping="Wrap" />
                            </StackPanel>
                            <controls:SirajVectorIcon x:Name="MoonChevron" Grid.Column="2" IconKey="chevron_right"
                                                      Width="18" Height="18" Brush="{ThemeResource SirajOnSurfaceVariantBrush}" Opacity="0.65" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SirajCard}" Background="{ThemeResource SirajPrimaryContainerBrush}" BorderBrush="{ThemeResource SirajPrimaryBorderBrush}">
                        <StackPanel Spacing="8">
                            <TextBlock x:Name="WidgetsTitle" Style="{StaticResource SirajHeading}" Foreground="{ThemeResource SirajOnPrimaryContainerBrush}" />
                            <TextBlock x:Name="WidgetsText" Style="{StaticResource SirajCaption}" Foreground="{ThemeResource SirajOnPrimaryContainerBrush}" />
                            <Button x:Name="WidgetsButton" Style="{StaticResource SirajPrimaryButton}" Margin="0,4,0,0" Click="OnWidgets" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
