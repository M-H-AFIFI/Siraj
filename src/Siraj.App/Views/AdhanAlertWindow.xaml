<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Siraj.App.Views.AdhanAlertWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Siraj.App.Controls"
    xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml">
    <Grid x:Name="Root" KeyDown="OnKeyDown" Background="#FF060A13">
        <canvas:CanvasControl x:Name="Sky" Draw="OnDraw" FlowDirection="LeftToRight" ClearColor="#FF060A13" />

        <Grid x:Name="DragRegion" Height="38" VerticalAlignment="Top" Background="Transparent" />

        <Grid Padding="28,36,28,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="1.15*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel x:Name="TopMeta" Grid.Row="0" Spacing="4" HorizontalAlignment="Center" Margin="0,2,0,0">
                <StackPanel Orientation="Horizontal" Spacing="9" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock x:Name="GregText" FontFamily="{StaticResource SirajFont}" FontSize="12.5" FontWeight="Medium"
                               Foreground="#B8FFFFFF" VerticalAlignment="Center" />
                    <Border Width="1" Height="11" CornerRadius="0.5" Background="#4DFFFFFF" VerticalAlignment="Center" />
                    <TextBlock x:Name="HijriTextBlock" FontFamily="{StaticResource SirajFont}" FontSize="12.5" FontWeight="Medium"
                               Foreground="#B8FFFFFF" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock x:Name="PlaceText" FontFamily="{StaticResource SirajFont}" FontSize="11.5"
                           Foreground="#7AFFFFFF" HorizontalAlignment="Center" TextAlignment="Center" />
            </StackPanel>

            <Grid x:Name="CenterpieceSlot" Grid.Row="2" Height="202" Margin="0,6,0,4" IsHitTestVisible="False" />

            <StackPanel x:Name="HeroStack" Grid.Row="3" Spacing="4" HorizontalAlignment="Center" Margin="0,6,0,0">
                <TextBlock x:Name="NowText" FontFamily="{StaticResource SirajFont}" FontSize="15.5" FontWeight="Medium"
                           Foreground="#D9FFFFFF" HorizontalAlignment="Center" TextAlignment="Center" />
                <TextBlock x:Name="NameText" FontFamily="{StaticResource SirajFont}" FontSize="50" FontWeight="Bold"
                           Foreground="White" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,-2,0,0" />
                <TextBlock x:Name="TimeText" FontFamily="{StaticResource SirajFont}" FontSize="22" FontWeight="SemiBold"
                           Foreground="#E0FFFFFF" HorizontalAlignment="Center" TextAlignment="Center" />

                <StackPanel x:Name="PillsRow" Spacing="8" HorizontalAlignment="Center" Margin="0,12,0,0">
                    <Border x:Name="IqamaPill" HorizontalAlignment="Center" CornerRadius="14" Padding="12,5,12,6"
                            Background="#1CFFFFFF" BorderBrush="#2EFFFFFF" BorderThickness="1">
                        <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                            <controls:SirajVectorIcon IconKey="timer" Width="14" Height="14"
                                                      Brush="#D4FFE099" VerticalAlignment="Center" />
                            <TextBlock x:Name="IqamaText" FontFamily="{StaticResource SirajFont}" FontSize="12.5" FontWeight="SemiBold"
                                       Foreground="#E0FFFFFF" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <Border x:Name="CallerPill" HorizontalAlignment="Center" CornerRadius="16" Padding="7,5,12,5"
                            Background="#17FFFFFF" BorderBrush="#26FFFFFF" BorderThickness="1">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <ContentControl x:Name="CallerAvatarSlot" VerticalAlignment="Center" />
                            <TextBlock x:Name="CallerText" FontFamily="{StaticResource SirajFont}" FontSize="12" FontWeight="Medium"
                                       Foreground="#CCFFFFFF" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="220" />
                            <ContentControl x:Name="CallerEqSlot" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>

            <StackPanel x:Name="ActionStack" Grid.Row="5" Spacing="13" HorizontalAlignment="Center">
                <Button x:Name="StopButton" Click="OnStop" HorizontalAlignment="Center"
                        MinWidth="268" Height="54" CornerRadius="27" BorderThickness="1"
                        UseSystemFocusVisuals="False" Padding="24,0">
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <controls:SirajVectorIcon x:Name="StopIcon" IconKey="notifications_off" Width="19" Height="19"
                                                  Brush="White" VerticalAlignment="Center" />
                        <TextBlock x:Name="StopLabel" FontFamily="{StaticResource SirajFont}" FontSize="16" FontWeight="SemiBold"
                                   Foreground="White" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <TextBlock x:Name="HintText" FontFamily="{StaticResource SirajFont}" FontSize="12"
                           Foreground="#80FFFFFF" HorizontalAlignment="Center" TextAlignment="Center"
                           TextWrapping="Wrap" MaxWidth="350" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
