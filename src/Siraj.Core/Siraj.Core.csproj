<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Siraj.Core</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <!-- Uses Windows' built-in winsqlite3.dll so no native SQLite binary needs to be bundled. -->
    <PackageReference Include="Microsoft.Data.Sqlite.Core" Version="10.0.14" />
    <PackageReference Include="SQLitePCLRaw.bundle_winsqlite3" Version="2.1.11" />
    <PackageReference Include="System.IO.Hashing" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Data\*.json" LogicalName="Siraj.Core.Data.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
